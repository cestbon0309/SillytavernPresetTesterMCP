{
  "name": "st-preset-workflow",
  "version": "0.1.0",
  "description": "Agent-facing SillyTavern preset testing & debugging toolkit (daemon + CLI + MCP)",
  "type": "module",
  "bin": {
    "stpd": "dist/cli.js",
    "stpd-mcp": "dist/mcp.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . --watch",
    "mock": "node test/mock-llm.mjs 8199 1500",
    "test:mcp": "node test/mcp-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ]
}
